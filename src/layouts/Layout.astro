---
// 1. Define the props to receive the title from individual pages
const { title } = Astro.props;

const siteName = "Felize Krook";
// 2. Create the combined string. If title exists, show "PAGE | Name", otherwise just "Name"
const fullTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--text: #000000;
		--gutter: 2rem;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background-color: var(--bg);
		color: var(--text);
		font-family: "Inter", sans-serif;
		-webkit-font-smoothing: antialiased;
		padding: var(--gutter);
	}

	@media (max-width: 900px) {
		body {
			padding: 1rem;
		}
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	/* Stabilize header layout and GPU rendering to prevent frame-drops */
	.hero {
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform;
	}

	.hero.header-hidden {
		transform: translateY(-100%);
	}
</style>

<script>
	function initHeaderScroll() {
		const header = document.querySelector(".hero") as HTMLElement;
		if (!header) return;

		const isMobile = () => window.innerWidth <= 900;

		let lastScrollY = 0;

		function handleScroll(currentScrollY: number, maxScrollY?: number) {
			if (!isMobile()) {
				header.classList.remove("header-hidden");
				return;
			}

			// Automatically show header when scrolled to the absolute bottom of the page
			if (maxScrollY !== undefined && currentScrollY >= maxScrollY - 10) {
				header.classList.remove("header-hidden");
				lastScrollY = currentScrollY;
				return;
			}

			// Hide when scrolling down, show immediately when scrolling up
			if (currentScrollY > lastScrollY && currentScrollY > 50) {
				header.classList.add("header-hidden");
			} else if (currentScrollY < lastScrollY) {
				header.classList.remove("header-hidden");
			}

			lastScrollY = Math.max(0, currentScrollY);
		}

		const scrollContainer = document.getElementById("scroll-container");
		if (scrollContainer) {
			scrollContainer.addEventListener("scroll", () => {
				const maxScrollY = scrollContainer.scrollHeight - scrollContainer.clientHeight;
				handleScroll(scrollContainer.scrollTop, maxScrollY);
			}, { passive: true });
		} else {
			window.addEventListener("scroll", () => {
				const currentScrollY = window.scrollY || document.documentElement.scrollTop;
				const maxScrollY = document.documentElement.scrollHeight - window.innerHeight;
				handleScroll(currentScrollY, maxScrollY);
			}, { passive: true });
		}

		window.addEventListener("resize", () => {
			if (!isMobile()) {
				header.classList.remove("header-hidden");
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeaderScroll);
	} else {
		initHeaderScroll();
	}
</script>
