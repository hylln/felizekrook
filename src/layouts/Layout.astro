---
// 1. Define the props to receive the title from individual pages
const { title } = Astro.props;

const siteName = "Felize Krook";
// 2. Create the combined string. If title exists, show "PAGE | Name", otherwise just "Name"
const fullTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--text: #000000;
		--gutter: 2rem;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background-color: var(--bg);
		color: var(--text);
		font-family: "Inter", sans-serif;
		-webkit-font-smoothing: antialiased;
		padding: var(--gutter);
	}

	@media (max-width: 900px) {
		body {
			padding: 1rem;
		}
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	/* Stabilize header layout and GPU rendering to prevent frame-drops */
	.hero {
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform;
	}

	.hero.header-hidden {
		transform: translateY(-100%) !important;
	}
</style>

<script>
	function initHeaderScroll() {
		const landingHero = document.getElementById("landing-trigger");
		const scrollContainer = document.getElementById("scroll-container");
		const header = document.querySelector(".hero") as HTMLElement;
		const footerCard = document.querySelector(".footer-card");

		const isMobile = () => window.innerWidth <= 900;

		if (landingHero && scrollContainer && header) {
			let isLandingVisible = true;
			let isFooterVisible = false;

			const updateHeaderVisibility = () => {
				if (!isMobile()) {
					header.classList.remove("header-hidden");
					return;
				}

				if (isLandingVisible || isFooterVisible) {
					header.classList.remove("header-hidden");
				} else {
					header.classList.add("header-hidden");
				}
			};

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.target === landingHero) {
							isLandingVisible = entry.isIntersecting;
						} else if (entry.target === footerCard) {
							isFooterVisible = entry.isIntersecting;
						}
					});
					updateHeaderVisibility();
				},
				{
					root: scrollContainer,
					threshold: 0.15,
				}
			);

			observer.observe(landingHero);
			if (footerCard) {
				observer.observe(footerCard);
			}

			window.addEventListener("resize", () => {
				updateHeaderVisibility();
			});
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeaderScroll);
	} else {
		initHeaderScroll();
	}
</script>
