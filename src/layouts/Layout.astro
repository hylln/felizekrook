---
// 1. Define the props to receive the title from individual pages
const { title } = Astro.props;

const siteName = "Felize Krook";
// 2. Create the combined string. If title exists, show "PAGE | Name", otherwise just "Name"
const fullTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:root {
		--bg: #ffffff;
		--text: #000000;
		--gutter: 2rem;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background-color: var(--bg);
		color: var(--text);
		font-family: "Inter", sans-serif;
		-webkit-font-smoothing: antialiased;
		padding: var(--gutter);
	}

	@media (max-width: 900px) {
		body {
			padding: 1rem;
		}
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}
</style>

<script>
	function initHeaderScroll() {
		const hero = document.querySelector(".hero") as HTMLElement;
		if (!hero) return;

		const isMobile = () => window.innerWidth <= 900;

		hero.style.transition = "transform 0.8s cubic-bezier(0.16, 1, 0.3, 1)";

		let lastScrollTop = 0;
		let accumulatedScroll = 0;
		const hideThreshold = 30;

		function handleScroll(scrollTop: number, maxScrollTop: number) {
			if (!isMobile()) {
				hero.style.transform = "translateY(0)";
				return;
			}

			// Automatically show header when scrolled to the absolute bottom of the page
			if (scrollTop >= maxScrollTop - 10) {
				hero.style.transform = "translateY(0)";
				lastScrollTop = scrollTop;
				return;
			}

			const diff = scrollTop - lastScrollTop;

			if (
				(diff > 0 && accumulatedScroll >= 0) ||
				(diff < 0 && accumulatedScroll <= 0)
			) {
				accumulatedScroll += diff;
			} else {
				accumulatedScroll = diff;
			}

			if (
				scrollTop > 80 &&
				diff > 0 &&
				accumulatedScroll > hideThreshold
			) {
				hero.style.transform = "translateY(-100%)";
			} else if (diff < 0 && accumulatedScroll < -hideThreshold) {
				hero.style.transform = "translateY(0)";
			}

			if (scrollTop <= 10) {
				hero.style.transform = "translateY(0)";
			}

			lastScrollTop = scrollTop;
		}

		const scrollContainer = document.getElementById("scroll-container");
		if (scrollContainer) {
			scrollContainer.addEventListener("scroll", () => {
				const maxScrollTop =
					scrollContainer.scrollHeight - scrollContainer.clientHeight;
				handleScroll(scrollContainer.scrollTop, maxScrollTop);
			});
		} else {
			window.addEventListener("scroll", () => {
				const maxScrollTop =
					document.documentElement.scrollHeight - window.innerHeight;
				handleScroll(
					window.scrollY || document.documentElement.scrollTop,
					maxScrollTop,
				);
			});
		}

		window.addEventListener("resize", () => {
			if (!isMobile()) {
				hero.style.transform = "translateY(0)";
			}
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeaderScroll);
	} else {
		initHeaderScroll();
	}
</script>
