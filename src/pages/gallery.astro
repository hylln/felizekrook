---
import Layout from "../layouts/Layout.astro";

const galleryImages = [
    { id: "01", src: "/19.jpeg" },
    { id: "02", src: "/10.jpeg" },
    { id: "03", src: "/11.jpeg" },
    { id: "04", src: "/12.jpeg" },
    { id: "05", src: "/13.jpeg" },
    { id: "06", src: "/18.jpeg" },
    { id: "07", src: "/14.jpeg" },
    { id: "08", src: "/15.jpeg" },
    { id: "09", src: "/16.jpeg" },
    { id: "10", src: "/17.jpeg" },
];
---

<Layout title="GALLERY">
    <header class="hero">
        <a href="/" class="logo-link">
            <h1>FELIZE KROOK</h1>
        </a>
        <nav class="header-nav">
            <a href="/gallery">GALLERY</a>
            <a href="/about">ABOUT</a>
            <a href="/contact">CONTACT</a>
        </nav>
    </header>

    <main class="contact-grid">
        <nav class="sub-nav">
            <a href="/" class="back-link">BACK</a>
        </nav>

        <section class="gallery-grid">
            {
                galleryImages.map((image) => (
                    <div class="gallery-item">
                        <img
                            src={image.src}
                            alt={`Project ${image.id}`}
                            class="zoom-img"
                        />
                        <div class="details">
                            <span>{image.id}</span>
                        </div>
                    </div>
                ))
            }
        </section>
    </main>

    <div id="lightbox" class="lightbox">
        <span class="close-lightbox" id="close-btn">&times;</span>

        <div class="nav-zone left" id="prev-zone">
            <div class="lightbox-arrow-container prev-arrow">
                <svg viewBox="0 0 100 20" preserveAspectRatio="none">
                    <line
                        x1="100"
                        y1="10"
                        x2="0"
                        y2="10"
                        stroke="black"
                        stroke-width="1.6"></line>
                    <polyline
                        points="4,4 0,10 4,16"
                        fill="none"
                        stroke="black"
                        stroke-width="1.6"></polyline>
                </svg>
            </div>
        </div>

        <div class="nav-zone right" id="next-zone">
            <div class="lightbox-arrow-container next-arrow">
                <svg viewBox="0 0 100 20" preserveAspectRatio="none">
                    <line
                        x1="0"
                        y1="10"
                        x2="100"
                        y2="10"
                        stroke="black"
                        stroke-width="1.6"></line>
                    <polyline
                        points="96,4 100,10 96,16"
                        fill="none"
                        stroke="black"
                        stroke-width="1.6"></polyline>
                </svg>
            </div>
        </div>

        <div class="lightbox-content-wrapper" id="lightbox-wrapper">
            <img
                class="lightbox-content"
                id="lightbox-img"
                alt="Fullscreen View"
            />
        </div>
    </div>
</Layout>

<style>
    :global(html) {
        scrollbar-gutter: stable;
    }

    .hero {
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: #ffffff;
        padding: 2rem 2rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.2);
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
    }

    .logo-link {
        text-decoration: none;
        color: inherit;
        display: inline-block;
        transition: opacity 0.3s ease;
    }

    .logo-link:hover {
        opacity: 0.7;
    }

    h1 {
        font-size: clamp(1rem, 2vw, 12rem);
        line-height: 0.85;
        letter-spacing: -0.05em;
        text-transform: uppercase;
        margin: 0;
        color: #000;
    }

    .header-nav {
        position: absolute;
        right: 2rem;
        display: flex;
        gap: 1.5rem;
    }

    .header-nav a {
        font-size: 0.7rem;
        text-decoration: none;
        color: #000;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: opacity 0.3s ease;
    }

    .header-nav a:hover {
        opacity: 0.6;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        padding: 3vh 2rem 0 2rem;
        overflow-x: hidden;
    }

    .sub-nav {
        grid-column: 1 / span 12;
        display: flex;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .back-link {
        font-size: 0.7rem;
        text-decoration: none;
        color: #000;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: opacity 0.3s ease;
    }

    .back-link:hover {
        opacity: 0.6;
    }

    .gallery-grid {
        grid-column: 1 / span 12;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 10px;
        column-gap: 2.25rem;
        row-gap: 0;
        padding: 3vh 2.5rem 6rem 2.5rem;
        width: 100%;
        box-sizing: border-box;
        max-width: 1600px;
        margin: 0 auto;
    }

    .gallery-item {
        width: 100%;
        opacity: 0;
        transform: translateY(30px);
        transition:
            opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
            transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .gallery-item.reveal-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .gallery-item .zoom-img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: unset;
        cursor: zoom-in;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }

    .gallery-item:hover .zoom-img {
        opacity: 0.92;
        transform: scale(1.02);
    }

    .gallery-item .details {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-top: 0.85rem;
        font-size: 0.65rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #000;
    }

    .lightbox {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 2000;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(2px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
            opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
            visibility 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        touch-action: none;
        -webkit-tap-highlight-color: transparent;
    }

    .lightbox.show {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .close-lightbox {
        position: absolute;
        top: 2rem;
        right: 2rem;
        font-size: 2.5rem;
        z-index: 3000;
        cursor: pointer;
    }

    .nav-zone {
        position: absolute;
        top: 0;
        height: 100%;
        width: 35%;
        z-index: 2010;
        cursor: pointer;
        transition:
            opacity 0.2s ease,
            visibility 0.2s ease;
    }

    .nav-zone.hiding {
        opacity: 0 !important;
        visibility: hidden;
        pointer-events: none;
    }

    .nav-zone.left {
        left: 0;
    }
    .nav-zone.right {
        right: 0;
    }

    .lightbox-arrow-container {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 80px;
        opacity: 1;
        transition: opacity 0.3s, left 0.3s ease, right 0.3s ease;
    }

    .nav-zone:hover .lightbox-arrow-container {
        opacity: 0.6;
    }

    .lightbox-content-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        will-change: transform, opacity;
        transition:
            transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1),
            opacity 0.3s ease;
    }

    .lightbox-content-wrapper.dragging {
        transition: none !important;
    }

    .lightbox-content {
        max-width: calc(100% - 280px);
        max-height: 80vh;
        object-fit: contain;
        user-select: none;
        pointer-events: auto;
        transform-origin: center center;
        transform: scale(0.9);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }

    .lightbox.show .lightbox-content {
        transform: scale(1);
    }

    .slide-out-left {
        transform: translate3d(-100%, 0, 0) !important;
        opacity: 0 !important;
    }

    .slide-out-right {
        transform: translate3d(100%, 0, 0) !important;
        opacity: 0 !important;
    }

    @media (max-width: 1100px) {
        .gallery-grid {
            grid-template-columns: repeat(3, 1fr);
            column-gap: 1.5rem;
        }
    }

    @media (max-width: 900px) {
        .hero {
            padding: 1.5rem 1rem;
            flex-direction: column;
            gap: 1rem;
            height: auto;
        }
        h1 {
            font-size: 1.4rem;
            width: 100%;
            text-align: center;
        }
        .header-nav {
            position: static;
            justify-content: center;
            gap: 2rem;
            width: 100%;
        }
        .nav-zone {
            display: none;
        }
        .lightbox-content {
            max-width: 90%;
        }
    }

    @media (max-width: 650px) {
        .gallery-grid {
            grid-template-columns: repeat(2, 1fr);
            column-gap: 1rem;
            padding: 2vh 1.25rem 4rem 1.25rem;
        }
    }
</style>

<script>
    function resizeMasonryItem(item: HTMLElement) {
        const grid = document.querySelector(".gallery-grid") as HTMLElement;
        if (!grid) return;
        const rowHeight = 10;
        const img = item.querySelector("img");
        const details = item.querySelector(".details");
        if (img && details) {
            const imgHeight = img.getBoundingClientRect().height;
            const detailsHeight = details.getBoundingClientRect().height;
            // 3rem (48px) editorial breathing room space between items in the column
            const totalHeight = imgHeight + detailsHeight + 48;
            item.style.gridRowEnd = `span ${Math.ceil(totalHeight / rowHeight)}`;
        }
    }

    const revealObserver = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("reveal-visible");
                    revealObserver.unobserve(entry.target);
                }
            });
        },
        { threshold: 0.1 },
    );

    const lightbox = document.getElementById("lightbox");
    const lightboxImg = document.getElementById(
        "lightbox-img",
    ) as HTMLImageElement;
    const lightboxWrapper = document.getElementById("lightbox-wrapper");
    const thumbImgs = document.querySelectorAll(
        ".zoom-img",
    ) as NodeListOf<HTMLImageElement>;
    const closeBtn = document.getElementById("close-btn");
    const prevZone = document.getElementById("prev-zone");
    const nextZone = document.getElementById("next-zone");

    let currentIndex = 0;
    const imgList = Array.from(thumbImgs).map((img) => img.src);
    let isAnimating = false;

    function getLightboxImageMargin() {
        if (!lightboxImg || !lightboxImg.naturalWidth) return 140;

        const W = window.innerWidth;
        const H = window.innerHeight;
        const imgW = lightboxImg.naturalWidth;
        const imgH = lightboxImg.naturalHeight;

        const maxW = W - 280;
        const maxH = H * 0.80;

        const imageRatio = imgW / imgH;

        let w = maxW;
        let h = w / imageRatio;

        if (h > maxH) {
            h = maxH;
            w = h * imageRatio;
        }

        return Math.max(140, (W - w) / 2);
    }

    function updateLightboxArrows() {
        const prevArrow = document.querySelector(".prev-arrow") as HTMLElement;
        const nextArrow = document.querySelector(".next-arrow") as HTMLElement;

        if (lightboxImg && prevArrow && nextArrow) {
            const margin = getLightboxImageMargin();
            let arrowOffset = margin - 45 - 80;
            arrowOffset = Math.max(20, arrowOffset);

            prevArrow.style.left = `${arrowOffset}px`;
            nextArrow.style.right = `${arrowOffset}px`;
        }
    }

    // Interaction Variables
    let startX = 0;
    let currentX = 0;
    let isDragging = false;
    let initialPinchDistance = 0;
    let isPinching = false;
    let lastTapTime = 0;
    let isDoubleTapZoomed = false;

    function getDistance(touches: TouchList) {
        const dx = touches[0].clientX - touches[1].clientX;
        const dy = touches[0].clientY - touches[1].clientY;
        return Math.sqrt(dx * dx + dy * dy);
    }

    function getPinchCenter(touches: TouchList, element: HTMLElement) {
        const rect = element.getBoundingClientRect();
        const centerX = (touches[0].clientX + touches[1].clientX) / 2;
        const centerY = (touches[0].clientY + touches[1].clientY) / 2;
        return `${((centerX - rect.left) / rect.width) * 100}% ${((centerY - rect.top) / rect.height) * 100}%`;
    }

    function getSingleTapCenter(touch: Touch, element: HTMLElement) {
        const rect = element.getBoundingClientRect();
        return `${((touch.clientX - rect.left) / rect.width) * 100}% ${((touch.clientY - rect.top) / rect.height) * 100}%`;
    }

    function updateImage(index: number, direction: "left" | "right") {
        if (!lightboxWrapper || !lightboxImg || isAnimating) return;
        isAnimating = true;

        prevZone?.classList.add("hiding");
        nextZone?.classList.add("hiding");

        const outClass =
            direction === "right" ? "slide-out-left" : "slide-out-right";
        lightboxWrapper.classList.add(outClass);

        setTimeout(() => {
            currentIndex = index;
            lightboxWrapper.style.transition = "none";
            lightboxWrapper.style.opacity = "0";
            lightboxWrapper.style.transform =
                direction === "right"
                    ? "translate3d(100%, 0, 0)"
                    : "translate3d(-100%, 0, 0)";
            lightboxImg.style.visibility = "hidden";
            lightboxImg.style.opacity = "0";
            lightboxImg.src = imgList[currentIndex];
            updateLightboxArrows();
            lightboxImg.style.transform = "scale(1)";
            lightboxImg.style.transformOrigin = "center center";
            isDoubleTapZoomed = false;
            lightboxWrapper.classList.remove(outClass);

            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    lightboxWrapper.style.transition = "";
                    lightboxWrapper.style.opacity = "1";
                    lightboxWrapper.style.transform = "translate3d(0, 0, 0)";
                    setTimeout(() => {
                        isAnimating = false;
                        prevZone?.classList.remove("hiding");
                        nextZone?.classList.remove("hiding");
                    }, 400);
                });
            });
        }, 350);
    }

    if (lightbox && lightboxWrapper && lightboxImg) {
        lightboxImg.addEventListener("load", () => {
            lightboxImg.style.visibility = "visible";
            lightboxImg.style.opacity = "1";
            updateLightboxArrows();
        });

        thumbImgs.forEach((img, i) =>
            img.addEventListener("click", () => {
                currentIndex = i;
                lightboxImg.style.visibility = "hidden";
                lightboxImg.style.opacity = "0";
                lightboxImg.src = imgList[currentIndex];
                lightboxImg.style.transform = "scale(1)";
                lightboxImg.style.transformOrigin = "center center";
                isDoubleTapZoomed = false;
                lightbox.classList.add("show");
                document.body.style.overflow = "hidden";
                updateLightboxArrows();
            }),
        );

        closeBtn?.addEventListener("click", () => {
            lightbox.classList.remove("show");
            document.body.style.overflow = "auto";
        });

        nextZone?.addEventListener("click", (e) => {
            e.stopPropagation();
            updateImage((currentIndex + 1) % imgList.length, "right");
        });
        prevZone?.addEventListener("click", (e) => {
            e.stopPropagation();
            updateImage(
                (currentIndex - 1 + imgList.length) % imgList.length,
                "left",
            );
        });

        lightbox.addEventListener(
            "touchstart",
            (e) => {
                if (isAnimating) return;
                if (e.touches.length === 1) {
                    const now = Date.now();
                    const timesince = now - lastTapTime;
                    if (timesince < 300 && timesince > 0) {
                        e.preventDefault();
                        if (!isDoubleTapZoomed) {
                            lightboxImg.style.transformOrigin =
                                getSingleTapCenter(e.touches[0], lightboxImg);
                            lightboxImg.style.transition =
                                "transform 0.3s ease";
                            lightboxImg.style.transform = "scale(2.5)";
                            isDoubleTapZoomed = true;
                        } else {
                            lightboxImg.style.transition =
                                "transform 0.3s ease";
                            lightboxImg.style.transform = "scale(1)";
                            isDoubleTapZoomed = false;
                        }
                        isDragging = false;
                        return;
                    }
                    lastTapTime = now;
                }
                if (e.touches.length === 2) {
                    isPinching = true;
                    isDragging = false;
                    initialPinchDistance = getDistance(e.touches);
                    lightboxImg.style.transformOrigin = getPinchCenter(
                        e.touches,
                        lightboxImg,
                    );
                } else if (e.touches.length === 1 && !isDoubleTapZoomed) {
                    startX = e.touches[0].clientX;
                    currentX = startX;
                    isDragging = true;
                    lightboxWrapper.classList.add("dragging");
                }
            },
            { passive: false },
        );

        lightbox.addEventListener(
            "touchmove",
            (e) => {
                if (isPinching && e.touches.length === 2) {
                    e.preventDefault();
                    const scale = getDistance(e.touches) / initialPinchDistance;
                    lightboxImg.style.transform = `scale(${scale})`;
                    lightboxImg.style.transition = "none";
                } else if (isDragging && !isPinching) {
                    currentX = e.touches[0].clientX;
                    const diff = currentX - startX;
                    lightboxWrapper.style.transform = `translate3d(${diff}px, 0, 0)`;
                    lightboxWrapper.style.opacity = Math.max(
                        0.5,
                        1 - Math.abs(diff) / window.innerWidth,
                    ).toString();
                }
            },
            { passive: false },
        );

        lightbox.addEventListener("touchend", (e) => {
            if (isPinching && e.touches.length < 2) {
                isPinching = false;
                lightboxImg.style.transition =
                    "transform 0.3s ease, transform-origin 0.3s ease";
                lightboxImg.style.transform = "scale(1)";
                isDoubleTapZoomed = false;
                setTimeout(() => {
                    lightboxImg.style.transformOrigin = "center center";
                }, 300);
            }
            if (isDragging) {
                isDragging = false;
                lightboxWrapper.classList.remove("dragging");
                const diff = currentX - startX;
                const threshold = window.innerWidth * 0.2;
                if (diff < -threshold)
                    updateImage((currentIndex + 1) % imgList.length, "right");
                else if (diff > threshold)
                    updateImage(
                        (currentIndex - 1 + imgList.length) % imgList.length,
                        "left",
                    );
                else {
                    lightboxWrapper.style.transform = "translate3d(0, 0, 0)";
                    lightboxWrapper.style.opacity = "1";
                }
            }
            startX = 0;
            currentX = 0;
        });

        lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) {
                lightbox.classList.remove("show");
                document.body.style.overflow = "auto";
            }
        });

        let accumDeltaX = 0;
        let wheelTimeout: any = null;
        let wheelSwipeTriggered = false;

        lightbox.addEventListener("wheel", (e) => {
            if (isAnimating) return;

            if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
                e.preventDefault();

                if (wheelSwipeTriggered) return;

                accumDeltaX += e.deltaX;

                lightboxWrapper.style.transform = `translate3d(${-accumDeltaX}px, 0, 0)`;
                lightboxWrapper.style.opacity = Math.max(
                    0.5,
                    1 - Math.abs(accumDeltaX) / window.innerWidth
                ).toString();
                lightboxWrapper.classList.add("dragging");

                const threshold = 100;

                if (accumDeltaX > threshold) {
                    wheelSwipeTriggered = true;
                    lightboxWrapper.classList.remove("dragging");
                    updateImage((currentIndex + 1) % imgList.length, "right");
                    resetAccumWheel();
                } else if (accumDeltaX < -threshold) {
                    wheelSwipeTriggered = true;
                    lightboxWrapper.classList.remove("dragging");
                    updateImage((currentIndex - 1 + imgList.length) % imgList.length, "left");
                    resetAccumWheel();
                }

                if (wheelTimeout) clearTimeout(wheelTimeout);
                wheelTimeout = setTimeout(() => {
                    if (!wheelSwipeTriggered) {
                        lightboxWrapper.style.transition = "transform 0.3s ease, opacity 0.3s ease";
                        lightboxWrapper.style.transform = "translate3d(0, 0, 0)";
                        lightboxWrapper.style.opacity = "1";
                        setTimeout(() => {
                            lightboxWrapper.style.transition = "";
                        }, 300);
                    }
                    resetAccumWheel();
                }, 150);
            }
        }, { passive: false });

        function resetAccumWheel() {
            accumDeltaX = 0;
            wheelSwipeTriggered = false;
        }

        window.addEventListener("keydown", (e) => {
            if (!lightbox.classList.contains("show")) return;
            if (e.key === "ArrowRight")
                updateImage((currentIndex + 1) % imgList.length, "right");
            else if (e.key === "ArrowLeft")
                updateImage(
                    (currentIndex - 1 + imgList.length) % imgList.length,
                    "left",
                );
            else if (e.key === "Escape") {
                lightbox.classList.remove("show");
                document.body.style.overflow = "auto";
            }
        });
    }

    function resizeAll() {
        document
            .querySelectorAll(".gallery-item")
            .forEach((c) => resizeMasonryItem(c as HTMLElement));
    }

    window.addEventListener("load", () => {
        resizeAll();
        document
            .querySelectorAll(".gallery-item")
            .forEach((c) => revealObserver.observe(c));
    });
    window.addEventListener("resize", () => {
        resizeAll();
        updateLightboxArrows();
    });

    // Handle cached images and instant rendering
    document.querySelectorAll(".gallery-item").forEach((item) => {
        const img = item.querySelector("img");
        if (img) {
            if (img.complete) {
                resizeMasonryItem(item as HTMLElement);
            } else {
                img.addEventListener("load", () => {
                    resizeMasonryItem(item as HTMLElement);
                });
            }
        }
    });
</script>
